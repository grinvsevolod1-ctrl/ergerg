# ===========================================
# NetNext Environment Variables
# ===========================================

# --- Domains (Required for production) ---
NEXT_PUBLIC_APP_URL=https://netnext.site
NEXT_PUBLIC_NEXIK_URL=https://nexik.org

# --- Database (Required) ---
DATABASE_URL=postgresql://user:password@localhost:5432/netnext

# --- Redis (Required for email queue and caching) ---
REDIS_URL=redis://localhost:6379

# --- Security (Required in production) ---
# Must be exactly 32 characters for AES-256 encryption
ENCRYPTION_KEY=your-32-character-encryption-key-here

# --- Nexik JWT (Required) ---
# Used for Nexik user authentication
NEXIK_JWT_SECRET=your-secure-jwt-secret-change-in-production

# --- Telegram Bot (Optional) ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
# TELEGRAM_OWNER_ID is an alias for TELEGRAM_CHAT_ID (for Python bot)
TELEGRAM_OWNER_ID=your-telegram-chat-id

# --- Email / SMTP ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=hello@netnext.site
SMTP_PASS=your-smtp-password
SMTP_FROM=hello@netnext.site
SMTP_FROM_NAME=NetNext
FROM_EMAIL=hello@netnext.site

# --- DKIM (for email signing, optional) ---
DKIM_DOMAIN=netnext.site
DKIM_SELECTOR=vps
DKIM_KEY_PATH=/etc/opendkim/keys/vps.private

# --- Admin API ---
ADMIN_API_TOKEN=your-secure-admin-token

# --- Email Rate Limits (optional) ---
MAILING_MAX_PER_HOUR=50
MAILING_DELAY_MS=5000

# --- Ollama AI (optional, for local AI) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Nexik AI Settings ---
# Default model for Nexik chat (Ollama model name)
NEXIK_AI_MODEL=qwen2.5:7b
# Max tokens per response
NEXIK_MAX_TOKENS=1000
# Widget domain for CORS
NEXIK_WIDGET_DOMAIN=https://nexik.io

# --- Base URL ---
NEXT_PUBLIC_BASE_URL=https://netnext.site

# --- Logging ---
# Levels: debug, info, warn, error
LOG_LEVEL=info

# --- Node Environment ---
# NODE_ENV=development
